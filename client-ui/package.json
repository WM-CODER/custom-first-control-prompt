{
  "name": "@wm-coders/dsh-client-ui-custom-first-control-prompt",
  "description": "Web panel surface for custom-first-control-prompt: composer dock request listener, settings editor, preview, and RAW patch management",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WM-CODER/custom-first-control-prompt.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-api-remotes": "0.1.x",
    "@deepseek-ai/dsh-client-locale": "0.1.x",
    "@deepseek-ai/dsh-client-runtime": "0.1.x",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.x",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.x",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.x",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.x",
    "@wm-coders/dsh-custom-first-control-prompt": "0.2.0",
    "@deepseek-ai/dsh-typert-protocol": "0.1.x",
    "@deepseek-ai/cordis": "4.0.1",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
